+// marv patch: terminal UIs measure the same strings over and over (every
+// frame redraws the same lines), and the slow path below costs a regex per
+// character. Remember results; the cap keeps memory bounded.
+const marvCache = new Map();
+const MARV_CACHE_LIMIT = 20000;
+
+// marv patch: a single code point that isn't Extended_Pictographic can't be
+// an RGI emoji, so the costly RGI_Emoji regex can be skipped for it (box
+// drawing, bullets, letters...). Sequences (flags, keycaps, ZWJ, modifiers)
+// still take the full check.
+const marvPictographic = /\p{Extended_Pictographic}/u;
+const marvMaybeEmoji = segment => {
+	const codePoint = segment.codePointAt(0);
+	const single = segment.length === (codePoint > 0xFFFF ? 2 : 1);
+	return !single || marvPictographic.test(segment);
+};
+
 export default function stringWidth(input, options = {}) {
+	if (typeof input === 'string' && input.length > 0) {
+		const key = (options?.ambiguousIsNarrow === false ? 'w' : 'n') + (options?.countAnsiEscapeCodes ? 'a' : '-') + input;
+		const cached = marvCache.get(key);
+		if (cached !== undefined) {
+			return cached;
+		}
+		const width = marvStringWidth(input, options);
+		if (marvCache.size >= MARV_CACHE_LIMIT) {
+			marvCache.clear();
+		}
+		marvCache.set(key, width);
+		return width;
+	}
+	return marvStringWidth(input, options);
+}
+
+function marvStringWidth(input, options = {}) {
 	if (typeof input !== 'string' || input.length === 0) {
